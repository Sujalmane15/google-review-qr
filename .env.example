# Google Gemini API Key (Server-side only, never expose to client)
GEMINI_API_KEY=

# Public application domain for QR generation (Must be HTTPS in production, e.g. https://your-domain.vercel.app)
NEXT_PUBLIC_APP_URL=https://example.com

# Admin Authentication Secret (Used to sign JWT session cookies)
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=your-random-32-character-secret-key-here

# Default Admin Password (Used to hash and authenticate at /dashboard)
ADMIN_PASSWORD=change-me-to-a-secure-password

# Optional: Production PostgreSQL connection string (e.g. Neon, Supabase, Vercel Postgres)
# If left empty, local isolated JSON/SQLite development adapter is used.
DATABASE_URL=
